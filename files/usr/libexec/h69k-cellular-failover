#!/bin/sh

# PCIe is intentionally the transport priority. On current upstream MHI, the
# RM520N-GL's dependable OpenWrt data protocol is MBIM; USB QMI is the backup.
STATE_DIR=/tmp/h69k-cellular
mkdir -p "$STATE_DIR"

iface_online() {
	status="$(ifstatus "$1" 2>/dev/null)" || return 1
	echo "$status" | jsonfilter -e '@.up' 2>/dev/null | grep -qx true || return 1
	echo "$status" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null | grep -q . && return 0
	echo "$status" | jsonfilter -e '@["ipv6-address"][0].address' 2>/dev/null | grep -q . && return 0
	echo "$status" | jsonfilter -e '@["ipv6-prefix"][0].address' 2>/dev/null | grep -q .
}

set_apn() {
	[ "$(uci -q get network.cell_pcie.apn)" = "$1" ] && \
	[ "$(uci -q get network.cell_usb_qmi.apn)" = "$1" ] && return 0
	uci set network.cell_pcie.apn="$1"
	uci set network.cell_usb_qmi.apn="$1"
	uci commit network
}

bring_up() {
	mode="$1"
	if [ "$mode" = pcie ]; then
		ifdown cell_usb_qmi 2>/dev/null
		ifup cell_pcie
	else
		ifdown cell_pcie 2>/dev/null
		ifup cell_usb_qmi
	fi
	echo "$mode" > "$STATE_DIR/mode"
	date +%s > "$STATE_DIR/since"
}

try_fallback_apn() {
	# Empty APN is tested first. If the carrier does not provide a default
	# context, cycle through the standard mainland China carrier APNs.
	index="$(cat "$STATE_DIR/apn-index" 2>/dev/null || echo 0)"
	case "$index" in
		0) apn=cmnet; next=1 ;;
		1) apn=3gnet; next=2 ;;
		2) apn=wonet; next=3 ;;
		*) apn=ctnet; next=0 ;;
	esac
	set_apn "$apn"
	echo "$next" > "$STATE_DIR/apn-index"
}

while true; do
	PCIE_DEVICE="$(uci -q get h69kcellular.main.pcie_device)"
	USB_QMI_DEVICE="$(uci -q get h69kcellular.main.usb_qmi_device)"
	APN="$(uci -q get h69kcellular.main.preferred_apn)"

	[ -n "$APN" ] && set_apn "$APN"

	pcie_present=0
	usb_present=0
	[ -c "$PCIE_DEVICE" ] && pcie_present=1
	[ -c "$USB_QMI_DEVICE" ] && usb_present=1
	if [ "$pcie_present" -eq 0 ] && [ "$usb_present" -eq 0 ]; then
		sleep 15
		continue
	fi

	previous="$(cat "$STATE_DIR/mode" 2>/dev/null || true)"
	if [ -z "$previous" ]; then
		if [ "$pcie_present" -eq 1 ]; then bring_up pcie; else bring_up usb; fi
		sleep 15
		continue
	fi

	if [ "$previous" = pcie ] && [ "$pcie_present" -eq 0 ]; then
		[ "$usb_present" -eq 1 ] && bring_up usb
		sleep 15
		continue
	fi
	if [ "$previous" = usb ] && [ "$usb_present" -eq 0 ]; then
		[ "$pcie_present" -eq 1 ] && bring_up pcie
		sleep 15
		continue
	fi

	now="$(date +%s)"
	probe_seconds="$(uci -q get h69kcellular.main.pcie_probe_seconds || echo 45)"
	retry_seconds="$(uci -q get h69kcellular.main.pcie_retry_seconds || echo 300)"
	fail_limit="$(uci -q get h69kcellular.main.pcie_failures_before_usb || echo 3)"

	if [ "$previous" = pcie ]; then
		if iface_online cell_pcie; then
			echo 0 > "$STATE_DIR/pcie-failures"
		else
			since="$(cat "$STATE_DIR/since" 2>/dev/null || echo "$now")"
			if [ $((now - since)) -ge "$probe_seconds" ]; then
				failures="$(cat "$STATE_DIR/pcie-failures" 2>/dev/null || echo 0)"
				failures=$((failures + 1))
				echo "$failures" > "$STATE_DIR/pcie-failures"
				[ -z "$APN" ] && try_fallback_apn
				if [ "$failures" -ge "$fail_limit" ] && [ "$usb_present" -eq 1 ]; then
					echo "$now" > "$STATE_DIR/last-pcie-attempt"
					bring_up usb
				else
					bring_up pcie
				fi
			fi
		fi
	else
		last_pcie="$(cat "$STATE_DIR/last-pcie-attempt" 2>/dev/null || echo 0)"
		if [ "$pcie_present" -eq 1 ] && [ $((now - last_pcie)) -ge "$retry_seconds" ]; then
			echo "$now" > "$STATE_DIR/last-pcie-attempt"
			echo 0 > "$STATE_DIR/pcie-failures"
			bring_up pcie
		elif ! iface_online cell_usb_qmi; then
			since="$(cat "$STATE_DIR/since" 2>/dev/null || echo "$now")"
			if [ $((now - since)) -ge "$probe_seconds" ]; then
				[ -z "$APN" ] && try_fallback_apn
				bring_up usb
			fi
		fi
	fi

	sleep 15
done
